PORT=4000
DATABASE_URL=postgresql://sgdpu:sgdpu_dev@localhost:5434/sgdpu
# Secreto aleatorio de 32+ caracteres. Con NODE_ENV=production el servidor no
# arranca si se deja este valor de ejemplo. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_local_secret
# Definir (p. ej. 1) solo si la API está detrás de un proxy inverso.
# TRUST_PROXY=1
JWT_EXPIRES=20m
REFRESH_DAYS=7
FRONTEND_URL=http://localhost:5173

# Correo institucional: puede apuntar a un relay SMTP de Google Workspace en
# producción, o a una cuenta Gmail con contraseña de aplicación en desarrollo.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=cuenta@usco.edu.co
SMTP_PASS=change_this
SMTP_FROM="SGDPU <no-reply@usco.edu.co>"
